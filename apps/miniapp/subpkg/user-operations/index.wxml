<view class="page">
  <view class="nav">
    <view class="nav-back" bindtap="goBack">‹</view>
    <view class="nav-title">用户运营</view>
    <view class="nav-spacer"></view>
  </view>

  <scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="loading-tip">加载中…</view>

    <block wx:else>
      <view class="stat-row">
        <view class="stat-card">
          <text class="stat-num">{{totalActive}}</text>
          <text class="stat-label">总活跃</text>
        </view>
        <view class="stat-card">
          <text class="stat-num">{{weekActive}}</text>
          <text class="stat-label">本周活跃</text>
        </view>
        <view class="stat-card">
          <text class="stat-num">{{todayActive}}</text>
          <text class="stat-label">今日活跃</text>
        </view>
      </view>

      <view class="section-title">用户账单明细</view>

      <view class="user-list">
        <view wx:for="{{userList}}" wx:key="id" class="user-item">
          <view class="user-left">
            <text class="user-name">{{item.nickname}}</text>
            <text class="user-id">ID {{item.id}}</text>
          </view>
          <view class="user-right">
            <text class="bill-count">{{item.billCount}} 条</text>
            <text class="last-active">{{item.lastActiveDate ? '最近活跃：' + item.lastActiveDate : '从未记账'}}</text>
          </view>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
