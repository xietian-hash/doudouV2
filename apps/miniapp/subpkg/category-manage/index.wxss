@import "../../styles/manage.wxss";

.swipe-content .manage-card {
  border-radius: 0;
}

.swipe-content .card-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
}

.icon-picker {
  max-height: 240rpx;
}

.field-picker-value {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--color-surface-soft);
  color: var(--color-text);
}

.icon-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12rpx;
}

.icon-option {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--color-surface-soft);
  font-size: 32rpx;
}

.icon-option--active {
  background: var(--color-selected);
  box-shadow: inset 0 0 0 2rpx var(--color-brand);
}

.icon-option-none {
  font-size: 22rpx;
  color: var(--color-text-sub);
}

.swipe-row--dragging {
  overflow: visible;
  box-shadow: 0 12rpx 40rpx rgba(43, 74, 58, 0.18);
}

.swipe-row--dragging .swipe-actions {
  display: none;
}

.swipe-row--dragging .swipe-content {
  border-radius: 36rpx;
  overflow: hidden;
}
